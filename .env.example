# Copy to .env (never commit .env) and fill in. docker compose reads this file automatically.

# Groq API key for the chatbot and recommendation wording. Create/rotate it at https://console.groq.com/keys
# Leave unset to run without the AI model: the app then answers from its records and says so.
GROQ_API_KEY=

# Shared secret for admin and write endpoints (header X-Admin-Token). Set this on any server others can reach.
# Generate one with: openssl rand -hex 32
ADMIN_API_TOKEN=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b      # must be a model your key can use; see https://api.groq.com/openai/v1/models
# POSTGRES_PORT=5433
# INGESTION_ENABLED=true            # scheduled official-source checks
# INGESTION_CRON=0 30 3 * * *       # 03:30 IST daily
# LLM_TIMEOUT_SECONDS=25
